# ─────────────────────────────────────────────────────────────────────────
# instagram.env — MOLDE (exemplo)
#
# Este arquivo é só o MOLDE. Os valores reais vão para
#   ~/.operacao-ia/config/instagram.env
# que fica FORA do repositório, com permissão 600. Nunca cole token, senha ou
# chave aqui — este arquivo é público.
#
# O jeito mais fácil de preencher tudo: rode `python3 setup/setup_publicacao_ig.py`.
# Passo a passo completo: docs/PUBLICACAO-AUTOMATICA-INSTAGRAM.md
# ─────────────────────────────────────────────────────────────────────────


# ── OBRIGATÓRIO ──────────────────────────────────────────────────────────

# ID numérico da sua conta profissional do Instagram.
IG_USER_ID=

# Token de longa duração do Instagram (vale 60 dias; o refresh semanal renova).
IG_ACCESS_TOKEN=

# Preenchido automaticamente quando o token é gerado/renovado. Não mexa.
# A renovação semanal LÊ este campo: token com menos de 24h ela nem tenta
# renovar, porque a Meta recusaria.
IG_TOKEN_GENERATED_AT=


# ── OPCIONAL — só precisa se você for gerar um token novo do zero ────────
# O dia a dia (publicar e renovar) NÃO usa estes dois campos.

# IG_APP_ID_INSTAGRAM=
# IG_APP_SECRET=


# ── HOSPEDAGEM DO VÍDEO ──────────────────────────────────────────────────
# A API do Instagram não aceita upload de arquivo local: o vídeo precisa estar
# numa URL pública HTTPS que responda como vídeo.
#
#   bunny  = o script sobe o MP4 sozinho para o Bunny Storage (automático)
#   manual = você hospeda onde quiser e cola a URL num arquivo .url ao lado
#            do vídeo (ex: meu-reel.mp4 + meu-reel.url)
IG_VIDEO_HOST_PROVIDER=bunny

# Preencha estes 5 só se escolheu "bunny":
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_HOST=
BUNNY_STORAGE_PASSWORD=
BUNNY_PULL_HOST=
BUNNY_FOLDER=reels


# ── COMPORTAMENTO ────────────────────────────────────────────────────────

# true  = o Reel também aparece no feed do perfil
# false = o Reel fica só na aba de Reels
IG_SHARE_TO_FEED=true
